+HANDLER_RESULT<BoardStackupResponse> API_HANDLER_PCB::handleUpdateBoardStackup(
+        const HANDLER_CONTEXT<UpdateBoardStackup>& aCtx )
+{
+    if( HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() ); !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    auto badRequest =
+            []( const std::string& aMessage ) -> HANDLER_RESULT<BoardStackupResponse>
+            {
+                return tl::unexpected( MakeResponseStatus( ApiStatusCode::AS_BAD_REQUEST, aMessage ) );
+            };
+
+    BOARD_STACKUP stackup;
+
+    if( !stackup.Deserialize( aCtx.Request.stackup() ) )
+        return badRequest( "the stackup contains a layer of unknown type or a layer that does not match its type" );
+
+    BOARD* board = this->board();
+    LSET   enabled = board->GetEnabledLayers();
+    LSEQ   copperStack = enabled.CuStack();
+    LSET   seen;
+    size_t copperIdx = 0;
+    bool   expectCopper = true;
+
+    // Copper and dielectric layers must alternate, starting and ending with copper, and the copper
+    // layers must be exactly the enabled ones; the layer count is changed with SetBoardEnabledLayers
+    for( const BOARD_STACKUP_ITEM* item : stackup.GetList() )
+    {
+        BOARD_STACKUP_ITEM_TYPE type = item->GetType();
+        PCB_LAYER_ID            layer = item->GetBrdLayerId();
+
+        if( type == BS_ITEM_TYPE_COPPER || type == BS_ITEM_TYPE_DIELECTRIC )
+        {
+            if( !item->IsEnabled() )
+                return badRequest( "copper and dielectric layers must be enabled" );
+
+            if( ( type == BS_ITEM_TYPE_COPPER ) != expectCopper )
+                return badRequest( "copper and dielectric layers must alternate, starting and ending with copper" );
+
+            expectCopper = !expectCopper;
+
+            for( int i = 0; i < item->GetSublayersCount(); ++i )
+            {
+                if( item->GetThickness( i ) <= 0 )
+                    return badRequest( "copper and dielectric thicknesses must be positive" );
+            }
+        }
+        else if( item->GetThickness() < 0 )
+        {
+            return badRequest( "layer thicknesses must not be negative" );
+        }
+
+        if( type == BS_ITEM_TYPE_DIELECTRIC )
+            continue;
+
+        if( type != BS_ITEM_TYPE_COPPER && copperIdx != ( IsFrontLayer( layer ) ? 0 : copperStack.size() ) )
+            return badRequest( "front technical layers must be above the copper layers, back ones below" );
+
+        if( !enabled.Contains( layer ) )
+            return badRequest( fmt::format( "layer {} is not enabled on the board", LSET::Name( layer ).ToStdString() ) );
+
+        if( seen.Contains( layer ) )
+            return badRequest( fmt::format( "layer {} appears more than once", LSET::Name( layer ).ToStdString() ) );
+
+        seen.set( layer );
+
+        if( type == BS_ITEM_TYPE_COPPER )
+        {
+            if( copperIdx >= copperStack.size() || copperStack[copperIdx] != layer )
+            {
+                return badRequest( fmt::format( "the copper layers must be the board's {} enabled copper layers "
+                                                "in order; change the layer count with SetBoardEnabledLayers first",
+                                                copperStack.size() ) );
+            }
+
+            copperIdx++;
+        }
+    }
+
+    if( copperIdx != copperStack.size() || expectCopper )
+    {
+        return badRequest( fmt::format( "the copper layers must be the board's {} enabled copper layers "
+                                        "in order; change the layer count with SetBoardEnabledLayers first",
+                                        copperStack.size() ) );
+    }
+
+    BOARD_DESIGN_SETTINGS& bds = board->GetDesignSettings();
+    bds.GetStackupDescriptor() = stackup;
+    bds.m_HasStackup = true;
+    bds.SetBoardThickness( stackup.BuildBoardThicknessFromStackup() );
+
+    onModified();
+
+    BoardStackupResponse response;
+    board::PackBoardStackup( *board, *response.mutable_stackup() );
+    return response;
+}
