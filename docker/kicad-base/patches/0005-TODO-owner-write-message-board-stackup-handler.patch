+BOOST_AUTO_TEST_CASE( UpdateBoardStackupLayerOrderRejected )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    before = getStackup( handler, *board );
+    BoardStackup    good = makeJlc4LayerStackup( before );
+
+    auto indexOf =
+            [&]( const BoardStackup& aStackup, kiapi::board::types::BoardLayer aLayer )
+            {
+                for( int i = 0; i < aStackup.layers_size(); ++i )
+                {
+                    if( aStackup.layers( i ).layer() == aLayer )
+                        return i;
+                }
+
+                BOOST_FAIL( "layer not in stackup" );
+                return -1;
+            };
+
+    std::vector<BoardStackup> bad;
+
+    // Two copper layers in a row (the first dielectric removed)
+    BoardStackup noDielectric = good;
+    noDielectric.clear_layers();
+    bool dropped = false;
+
+    for( const BoardStackupLayer& layer : good.layers() )
+    {
+        if( layer.type() == BSLT_DIELECTRIC && !dropped )
+        {
+            dropped = true;
+            continue;
+        }
+
+        *noDielectric.add_layers() = layer;
+    }
+
+    bad.push_back( noDielectric );
+
+    // A copper layer the board does not have (In3.Cu instead of In2.Cu)
+    BoardStackup wrongLayer = good;
+    wrongLayer.mutable_layers( indexOf( good, kiapi::board::types::BL_In2_Cu ) )->set_layer( kiapi::board::types::BL_In3_Cu );
+    bad.push_back( wrongLayer );
+
+    // Enabled copper layers out of stack order (In1.Cu and In2.Cu swapped)
+    BoardStackup swapped = good;
+    swapped.mutable_layers( indexOf( good, kiapi::board::types::BL_In1_Cu ) )->set_layer( kiapi::board::types::BL_In2_Cu );
+    swapped.mutable_layers( indexOf( good, kiapi::board::types::BL_In2_Cu ) )->set_layer( kiapi::board::types::BL_In1_Cu );
+    bad.push_back( swapped );
+
+    // A front technical layer below the copper layers
+    BoardStackup maskBelow = good;
+    maskBelow.clear_layers();
+    BoardStackupLayer frontMask = good.layers( indexOf( good, kiapi::board::types::BL_F_Mask ) );
+
+    for( const BoardStackupLayer& layer : good.layers() )
+    {
+        if( layer.layer() != kiapi::board::types::BL_F_Mask )
+            *maskBelow.add_layers() = layer;
+    }
+
+    *maskBelow.add_layers() = frontMask;
+    bad.push_back( maskBelow );
+
+    // A layer twice
+    BoardStackup duplicate = good;
+    *duplicate.add_layers() = good.layers( indexOf( good, kiapi::board::types::BL_B_Mask ) );
+    bad.push_back( duplicate );
+
+    // A layer that does not match its type (solder mask on a copper layer)
+    BoardStackup typeMismatch = good;
+    typeMismatch.mutable_layers( indexOf( good, kiapi::board::types::BL_F_Mask ) )->set_layer( kiapi::board::types::BL_F_Cu );
+    bad.push_back( typeMismatch );
+
+    // A disabled copper layer
+    BoardStackup disabled = good;
+    disabled.mutable_layers( indexOf( good, kiapi::board::types::BL_In1_Cu ) )->set_enabled( false );
+    bad.push_back( disabled );
+
+    for( const BoardStackup& stackup : bad )
+    {
+        kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, stackup );
+        API_RESULT                result = handler.Handle( request );
+
+        BOOST_REQUIRE( !result.has_value() );
+        BOOST_CHECK_EQUAL( result.error().status(), kiapi::common::ApiStatusCode::AS_BAD_REQUEST );
+    }
+
+    BOOST_CHECK( !board->GetDesignSettings().m_HasStackup );
+    BOOST_CHECK( getStackup( handler, *board ).SerializeAsString() == before.SerializeAsString() );
+}
