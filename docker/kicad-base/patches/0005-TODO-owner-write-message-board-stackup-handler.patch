+BOOST_AUTO_TEST_CASE( UpdateBoardStackupInvalidValuesRejected )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    before = getStackup( handler, *board );
+
+    auto firstDielectric =
+            []( BoardStackup& aStackup ) -> BoardStackupLayer&
+            {
+                for( BoardStackupLayer& layer : *aStackup.mutable_layers() )
+                {
+                    if( layer.type() == BSLT_DIELECTRIC )
+                        return layer;
+                }
+
+                throw std::runtime_error( "no dielectric" );
+            };
+
+    auto send =
+            [&]( const BoardStackup& aStackup )
+            {
+                kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, aStackup );
+                return handler.Handle( request );
+            };
+
+    std::vector<std::function<void( BoardStackup& )>> edits = {
+        // Thickness beyond the int range, just above the 10 mm limit
+        [&]( BoardStackup& s ) { firstDielectric( s ).mutable_dielectric()->mutable_layer( 0 )->mutable_thickness()->set_value_nm( ( int64_t( 1 ) << 32 ) + 35000 ); },
+        [&]( BoardStackup& s ) { firstDielectric( s ).mutable_dielectric()->mutable_layer( 0 )->mutable_thickness()->set_value_nm( 10000001 ); },
+        // 11 sub-layers of 10 mm: each allowed, the total above 100 mm
+        [&]( BoardStackup& s )
+        {
+            BoardStackupDielectricLayer* d = firstDielectric( s ).mutable_dielectric();
+
+            for( int i = 0; i < 11; ++i )
+            {
+                BoardStackupDielectricProperties* p = i == 0 ? d->mutable_layer( 0 ) : d->add_layer();
+                *p = d->layer( 0 );
+                p->mutable_thickness()->set_value_nm( 10000000 );
+            }
+        },
+        // Too many sub-layers
+        [&]( BoardStackup& s )
+        {
+            BoardStackupDielectricLayer* d = firstDielectric( s ).mutable_dielectric();
+
+            while( d->layer_size() <= 32 )
+                *d->add_layer() = d->layer( 0 );
+        },
+        // NaN / negative / infinite material values, on a dielectric and on the solder mask
+        [&]( BoardStackup& s ) { firstDielectric( s ).mutable_dielectric()->mutable_layer( 0 )->set_epsilon_r( std::nan( "" ) ); },
+        [&]( BoardStackup& s ) { firstDielectric( s ).mutable_dielectric()->mutable_layer( 0 )->set_loss_tangent( -0.02 ); },
+        [&]( BoardStackup& s ) { firstDielectric( s ).mutable_dielectric()->mutable_layer( 0 )->set_spec_frequency( std::numeric_limits<double>::infinity() ); },
+        [&]( BoardStackup& s )
+        {
+            for( BoardStackupLayer& layer : *s.mutable_layers() )
+            {
+                if( layer.type() == BSLT_SOLDERMASK )
+                    layer.mutable_soldermask()->set_epsilon_r( std::nan( "" ) );
+            }
+        },
+        // Proto enum values KiCad does not know: edge connector, board layer, layer type
+        [&]( BoardStackup& s ) { s.mutable_edge()->mutable_connector()->set_type( static_cast<BoardEdgeConnectorType>( 99 ) ); },
+        [&]( BoardStackup& s ) { s.mutable_layers( 0 )->set_layer( static_cast<kiapi::board::types::BoardLayer>( 999 ) ); },
+        [&]( BoardStackup& s ) { s.mutable_layers( 0 )->set_type( static_cast<BoardStackupLayerType>( 99 ) ); },
+        // More layers than a board can have
+        [&]( BoardStackup& s )
+        {
+            while( s.layers_size() <= 2 * PCB_LAYER_ID_COUNT )
+                *s.add_layers() = s.layers( 0 );
+        },
+    };
+
+    for( const auto& edit : edits )
+    {
+        BoardStackup bad = makeJlc4LayerStackup( before );
+        edit( bad );
+
+        API_RESULT result = send( bad );
+        BOOST_REQUIRE( !result.has_value() );
+        BOOST_CHECK_EQUAL( result.error().status(), kiapi::common::ApiStatusCode::AS_BAD_REQUEST );
+    }
+
+    BOOST_CHECK( !board->GetDesignSettings().m_HasStackup );
+    BOOST_CHECK( getStackup( handler, *board ).SerializeAsString() == before.SerializeAsString() );
+
+    // Exactly 10 mm is allowed
+    BoardStackup thick = makeJlc4LayerStackup( before );
+    BoardStackupLayer& d = firstDielectric( thick );
+    d.mutable_thickness()->set_value_nm( 10000000 );
+    d.mutable_dielectric()->mutable_layer( 0 )->mutable_thickness()->set_value_nm( 10000000 );
+    BOOST_CHECK( send( thick ).has_value() );
+}
