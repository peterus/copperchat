index 96df23b4..6969a6d7 100644
--- a/pcbnew/board_stackup_manager/board_stackup.cpp
+++ b/pcbnew/board_stackup_manager/board_stackup.cpp
@@ -21,6 +21,7 @@
 
 #include "board_stackup.h"
 #include <algorithm>
+#include <cmath>
 #include <base_units.h>
 #include <string_utils.h>
 #include <layer_ids.h>
@@ -579,7 +580,6 @@ void BOARD_STACKUP::Serialize( google::protobuf::Any& aContainer ) const
 
 bool BOARD_STACKUP::Deserialize( const google::protobuf::Any& aContainer )
 {
