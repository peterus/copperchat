+BOOST_AUTO_TEST_CASE( UpdateBoardStackupLayerOrderRejected )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    good = makeJlc4LayerStackup( getStackup( handler, *board ) );
+
+    // Two copper layers in a row (a dielectric removed, one added at the end)
+    BoardStackup noDielectric = good;
+    noDielectric.clear_layers();
+    bool dropped = false;
+
+    for( const BoardStackupLayer& layer : good.layers() )
+    {
+        if( layer.type() == BSLT_DIELECTRIC && !dropped )
+        {
+            dropped = true;
+            continue;
+        }
+
+        *noDielectric.add_layers() = layer;
+    }
+
+    // A copper layer the board does not have (In3.Cu instead of In2.Cu)
+    BoardStackup wrongLayer = good;
+
+    for( BoardStackupLayer& layer : *wrongLayer.mutable_layers() )
+    {
+        if( layer.layer() == types::BL_In2_Cu )
+            layer.set_layer( types::BL_In3_Cu );
+    }
+
+    for( const BoardStackup& bad : { noDielectric, wrongLayer } )
+    {
+        kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, bad );
+        API_RESULT                result = handler.Handle( request );
+
+        BOOST_REQUIRE( !result.has_value() );
+        BOOST_CHECK_EQUAL( result.error().status(), kiapi::common::ApiStatusCode::AS_BAD_REQUEST );
+    }
+
+    BOOST_CHECK( !board->GetDesignSettings().m_HasStackup );
+}
