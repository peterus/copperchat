+BOOST_AUTO_TEST_CASE( SetBoardEnabledLayersKeepsStackupInSync )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    wanted = makeJlc4LayerStackup( getStackup( handler, *board ) );
+
+    kiapi::common::ApiRequest update = makeUpdateStackupRequest( *board, wanted );
+    BOOST_REQUIRE( handler.Handle( update ).has_value() );
+
+    kiapi::common::ApiRequest six = makeSetEnabledLayersRequest( *board, 6 );
+    BOOST_REQUIRE( handler.Handle( six ).has_value() );
+
+    // The stored stackup follows the copper layer count; F.Cu keeps its thickness
+    BoardStackup         readBack = getStackup( handler, *board );
+    std::vector<int64_t> copper = thicknesses( readBack, BSLT_COPPER );
+    BOOST_CHECK_EQUAL( copper.size(), 6u );
+    BOOST_CHECK_EQUAL( thicknesses( readBack, BSLT_DIELECTRIC ).size(), 5u );
+    BOOST_REQUIRE( !copper.empty() );
+    BOOST_CHECK_EQUAL( copper.front(), JLC_4L_COPPER.front() );
+
+    const BOARD_DESIGN_SETTINGS& bds = board->GetDesignSettings();
+    BOOST_CHECK_EQUAL( bds.GetBoardThickness(), bds.GetStackupDescriptor().BuildBoardThicknessFromStackup() );
+}
