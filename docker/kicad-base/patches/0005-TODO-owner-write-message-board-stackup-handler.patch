     kiapi::board::BoardStackup stackup;
 
     if( !aContainer.UnpackTo( &stackup ) )
@@ -591,8 +591,196 @@ bool BOARD_STACKUP::Deserialize( const google::protobuf::Any& aContainer )
 
 bool BOARD_STACKUP::Deserialize( const kiapi::board::BoardStackup& aInput )
 {
-    // Read-only for now
-    return false;
+    using namespace kiapi::board;
+
+    BOARD_STACKUP stackup;
+    int           dielectricId = 0;
+
+    // Thicknesses are stored and summed as int: at most 10 mm per (sub-)layer, 100 mm in total
+    constexpr int64_t maxThickness = 10000000;
+    constexpr int64_t maxTotalThickness = 100000000;
+    constexpr int     maxSublayers = 32;
+
+    auto validThickness =
+            []( const kiapi::common::types::Distance& aDistance )
+            {
+                return aDistance.value_nm() >= 0 && aDistance.value_nm() <= maxThickness;
+            };
+
+    auto validMaterialValue =
+            []( double aValue )
+            {
+                return std::isfinite( aValue ) && aValue >= 0.0;
+            };
+
+    // A stackup has at most one item per board layer plus the dielectrics between them
+    if( aInput.layers_size() > 2 * PCB_LAYER_ID_COUNT )
+        return false;
+
+    for( const BoardStackupLayer& layer : aInput.layers() )
+    {
+        if( !validThickness( layer.thickness() ) )
+            return false;
+
+        if( layer.type() != BoardStackupLayerType::BSLT_COPPER
+            && layer.type() != BoardStackupLayerType::BSLT_DIELECTRIC
+            && layer.type() != BoardStackupLayerType::BSLT_SOLDERMASK
+            && layer.type() != BoardStackupLayerType::BSLT_SOLDERPASTE
+            && layer.type() != BoardStackupLayerType::BSLT_SILKSCREEN )
+        {
+            return false;
+        }
+
+        BOARD_STACKUP_ITEM_TYPE type = FromProtoEnum<BOARD_STACKUP_ITEM_TYPE>( layer.type() );
+        PCB_LAYER_ID            layerId = UNDEFINED_LAYER;
+
+        if( type != BS_ITEM_TYPE_DIELECTRIC )
+        {
+            if( !kiapi::board::types::BoardLayer_IsValid( layer.layer() ) )
+                return false;
+
+            layerId = FromProtoEnum<PCB_LAYER_ID>( layer.layer() );
+
+            bool typeMatches = false;
+
+            switch( type )
+            {
+            case BS_ITEM_TYPE_COPPER:      typeMatches = IsCopperLayer( layerId );                    break;
+            case BS_ITEM_TYPE_SOLDERMASK:  typeMatches = layerId == F_Mask || layerId == B_Mask;      break;
+            case BS_ITEM_TYPE_SOLDERPASTE: typeMatches = layerId == F_Paste || layerId == B_Paste;    break;
+            case BS_ITEM_TYPE_SILKSCREEN:  typeMatches = layerId == F_SilkS || layerId == B_SilkS;    break;
+            default:                                                                                  break;
+            }
+
+            if( !typeMatches )
+                return false;
+        }
+
+        BOARD_STACKUP_ITEM* item = new BOARD_STACKUP_ITEM( type );
+        stackup.Add( item );
+
+        item->SetBrdLayerId( layerId );
+        item->SetEnabled( layer.enabled() );
+
+        if( layer.has_color() && item->IsColorEditable() )
+            item->SetColor( kiapi::common::UnpackColor( layer.color() ).ToHexString() );
+
+        switch( type )
+        {
+        case BS_ITEM_TYPE_COPPER:
+            item->SetThickness( layer.thickness().value_nm() );
+            break;
+
+        case BS_ITEM_TYPE_DIELECTRIC:
+        {
+            const BoardStackupDielectricLayer& dielectric = layer.dielectric();
+
+            item->SetDielectricLayerId( ++dielectricId );
+
+            if( dielectric.type() == BoardStackupDielectricType::BSDT_PREPREG )
+                item->SetTypeName( KEY_PREPREG );
+            else
+                item->SetTypeName( KEY_CORE );
+
+            if( dielectric.layer_size() == 0 )
+            {
+                item->SetThickness( layer.thickness().value_nm() );
+                break;
+            }
+
+            if( dielectric.layer_size() > maxSublayers )
+                return false;
+
+            for( int i = 0; i < dielectric.layer_size(); ++i )
+            {
+                const BoardStackupDielectricProperties& props = dielectric.layer( i );
+
+                if( !validThickness( props.thickness() ) || !validMaterialValue( props.epsilon_r() )
+                    || !validMaterialValue( props.loss_tangent() )
+                    || !validMaterialValue( props.has_spec_frequency() ? props.spec_frequency() : 0.0 ) )
+                {
+                    return false;
+                }
+
+                if( i > 0 )
+                    item->AddDielectricPrms( i );
+
+                item->SetThickness( props.thickness().value_nm(), i );
+                item->SetThicknessLocked( props.thickness_locked(), i );
+                item->SetMaterial( wxString::FromUTF8( props.material_name() ), i );
+                item->SetEpsilonR( props.epsilon_r(), i );
+                item->SetLossTangent( props.loss_tangent(), i );
+                item->SetSpecFreq( props.has_spec_frequency() ? props.spec_frequency() : 0.0, i );
+
+                if( props.dielectric_model() == DielectricModel::DM_DJORDJEVIC_SARKAR )
+                    item->SetDielectricModel( DIELECTRIC_MODEL::DJORDJEVIC_SARKAR, i );
+                else
+                    item->SetDielectricModel( DIELECTRIC_MODEL::CONSTANT, i );
+            }
+
+            break;
+        }
+
+        case BS_ITEM_TYPE_SOLDERMASK:
+        {
+            const BoardStackupSoldermaskLayer& soldermask = layer.soldermask();
+
+            if( !validThickness( soldermask.thickness() ) || !validMaterialValue( soldermask.epsilon_r() )
+                || !validMaterialValue( soldermask.loss_tangent() ) )
+            {
+                return false;
+            }
+
+            item->SetTypeName( layerId == F_Mask ? _HKI( "Top Solder Mask" ) : _HKI( "Bottom Solder Mask" ) );
+            item->SetThickness( soldermask.thickness().value_nm() );
+            item->SetMaterial( wxString::FromUTF8( soldermask.material_name() ) );
+            item->SetEpsilonR( soldermask.epsilon_r() );
+            item->SetLossTangent( soldermask.loss_tangent() );
+            break;
+        }
+
+        case BS_ITEM_TYPE_SOLDERPASTE:
+            item->SetTypeName( layerId == F_Paste ? _HKI( "Top Solder Paste" ) : _HKI( "Bottom Solder Paste" ) );
+            break;
+
+        case BS_ITEM_TYPE_SILKSCREEN:
+            item->SetTypeName( layerId == F_SilkS ? _HKI( "Top Silk Screen" ) : _HKI( "Bottom Silk Screen" ) );
+            item->SetMaterial( wxString::FromUTF8( layer.silkscreen().material_name() ) );
+            break;
+
+        default:
+            break;
+        }
+    }
+
+    if( !aInput.finish().type_name().empty() )
+        stackup.m_FinishType = wxString::FromUTF8( aInput.finish().type_name() );
+
+    stackup.m_HasDielectricConstrains = aInput.impedance().is_controlled();
+
+    BoardEdgeConnectorType connector = aInput.edge().connector().type();
+
+    if( !BoardEdgeConnectorType_IsValid( connector ) )
+        return false;
+
+    if( connector != BoardEdgeConnectorType::BECT_UNKNOWN )
+        stackup.m_EdgeConnectorConstraints = FromProtoEnum<BS_EDGE_CONNECTOR_CONSTRAINTS>( connector );
+
+    stackup.m_EdgePlating = aInput.edge().plating().has_edge_plating();
+
+    int64_t total = 0;
+
+    for( const BOARD_STACKUP_ITEM* item : stackup.GetList() )
+    {
+        for( int i = 0; i < item->GetSublayersCount(); ++i )
+            total += item->GetThickness( i );
+    }
+
+    if( total > maxTotalThickness )
+        return false;
+
+    *this = stackup;
+    return true;
 }
 
 
