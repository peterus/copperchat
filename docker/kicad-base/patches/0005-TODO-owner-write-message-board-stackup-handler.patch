+BOOST_AUTO_TEST_CASE( UpdateBoardStackupInvalidThicknessRejected )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    before = getStackup( handler, *board );
+
+    for( BoardStackupLayerType type : { BSLT_DIELECTRIC, BSLT_COPPER } )
+    {
+        BoardStackup bad = makeJlc4LayerStackup( before );
+
+        for( BoardStackupLayer& layer : *bad.mutable_layers() )
+        {
+            if( layer.type() != type )
+                continue;
+
+            layer.mutable_thickness()->set_value_nm( 0 );
+
+            if( type == BSLT_DIELECTRIC )
+                layer.mutable_dielectric()->mutable_layer( 0 )->mutable_thickness()->set_value_nm( 0 );
+
+            break;
+        }
+
+        kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, bad );
+        API_RESULT                result = handler.Handle( request );
+
+        BOOST_REQUIRE( !result.has_value() );
+        BOOST_CHECK_EQUAL( result.error().status(), kiapi::common::ApiStatusCode::AS_BAD_REQUEST );
+    }
+
+    BOOST_CHECK( !board->GetDesignSettings().m_HasStackup );
+    BOOST_CHECK( getStackup( handler, *board ).SerializeAsString() == before.SerializeAsString() );
+}
