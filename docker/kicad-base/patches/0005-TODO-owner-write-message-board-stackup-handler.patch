+kiapi::board::BoardStackup getStackup( API_HANDLER_PCB& aHandler, const BOARD& aBoard )
+{
+    kiapi::common::ApiRequest request = makeGetStackupRequest( aBoard );
+    API_RESULT                result = aHandler.Handle( request );
+    BOOST_REQUIRE( result.has_value() );
+
+    kiapi::board::commands::BoardStackupResponse response;
+    BOOST_REQUIRE( result->message().UnpackTo( &response ) );
+    return response.stackup();
+}
