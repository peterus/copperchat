+BOOST_AUTO_TEST_CASE( UpdateBoardStackupRoundTrip )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    wanted = makeJlc4LayerStackup( getStackup( handler, *board ) );
+
+    kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, wanted );
+    API_RESULT                result = handler.Handle( request );
+
+    if( !result.has_value() )
+    {
+        BOOST_FAIL( "UpdateBoardStackup returned status " << result.error().status() << ": "
+                                                           << result.error().error_message() );
+    }
+
+    commands::BoardStackupResponse response;
+    BOOST_REQUIRE( result->message().UnpackTo( &response ) );
+    BOOST_CHECK( thicknesses( response.stackup(), BSLT_COPPER ) == JLC_4L_COPPER );
+    BOOST_CHECK( thicknesses( response.stackup(), BSLT_DIELECTRIC ) == JLC_4L_DIELECTRIC );
+
+    BoardStackup readBack = getStackup( handler, *board );
+    BOOST_CHECK( thicknesses( readBack, BSLT_COPPER ) == JLC_4L_COPPER );
+    BOOST_CHECK( thicknesses( readBack, BSLT_DIELECTRIC ) == JLC_4L_DIELECTRIC );
+
+    const BoardStackupLayer* core = nullptr;
+
+    for( const BoardStackupLayer& layer : readBack.layers() )
+    {
+        if( layer.type() == BSLT_DIELECTRIC && layer.dielectric().type() == BSDT_CORE )
+            core = &layer;
+    }
+
+    BOOST_REQUIRE( core );
+    BOOST_CHECK_EQUAL( core->dielectric().layer( 0 ).material_name(), "FR4 core" );
+    BOOST_CHECK_CLOSE( core->dielectric().layer( 0 ).epsilon_r(), 4.6, 1e-9 );
+
+    // Stored on the board: saved with the board, and the board thickness follows the stackup
+    const BOARD_DESIGN_SETTINGS& bds = board->GetDesignSettings();
+    BOOST_CHECK( bds.m_HasStackup );
+    BOOST_CHECK_EQUAL( bds.GetBoardThickness(), bds.GetStackupDescriptor().BuildBoardThicknessFromStackup() );
+    BOOST_CHECK_EQUAL( bds.GetStackupDescriptor().GetCount(), wanted.layers_size() );
+}
