+BOOST_AUTO_TEST_CASE( UpdateBoardStackupKeepsColorNames )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    // A stored stackup with KiCad's colour names, as the board setup dialog writes them
+    BOARD_DESIGN_SETTINGS& bds = board->GetDesignSettings();
+    BOARD_STACKUP          stored = board->GetStackupOrDefault();
+
+    for( BOARD_STACKUP_ITEM* item : stored.GetList() )
+    {
+        if( item->GetBrdLayerId() == F_Mask )
+            item->SetColor( wxS( "Green" ) );
+        else if( item->GetType() == BS_ITEM_TYPE_DIELECTRIC && item->GetDielectricLayerId() == 1 )
+            item->SetColor( wxS( "FR4 natural" ) );
+    }
+
+    bds.GetStackupDescriptor() = stored;
+    bds.m_HasStackup = true;
+
+    API_HANDLER_PCB           handler( m_context );
+    kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, getStackup( handler, *board ) );
+    BOOST_REQUIRE( handler.Handle( request ).has_value() );
+
+    int checked = 0;
+
+    for( const BOARD_STACKUP_ITEM* item : bds.GetStackupDescriptor().GetList() )
+    {
+        if( item->GetBrdLayerId() == F_Mask )
+        {
+            BOOST_CHECK_EQUAL( item->GetColor(), wxString( wxS( "Green" ) ) );
+            checked++;
+        }
+        else if( item->GetType() == BS_ITEM_TYPE_DIELECTRIC && item->GetDielectricLayerId() == 1 )
+        {
+            BOOST_CHECK_EQUAL( item->GetColor(), wxString( wxS( "FR4 natural" ) ) );
+            checked++;
+        }
+    }
+
+    BOOST_CHECK_EQUAL( checked, 2 );
+}
