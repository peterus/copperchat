+kiapi::common::ApiRequest makeGetStackupRequest( const BOARD& aBoard )
+{
+    kiapi::board::commands::GetBoardStackup command;
+    *command.mutable_board() = makeBoardDocument( aBoard );
+
+    kiapi::common::ApiRequest request;
+    request.mutable_header()->set_client_name( "kicad.qa" );
+    BOOST_REQUIRE( request.mutable_message()->PackFrom( command ) );
+
+    return request;
+}
+
+
+kiapi::common::ApiRequest makeUpdateStackupRequest( const BOARD& aBoard,
+                                                    const kiapi::board::BoardStackup& aStackup )
+{
+    kiapi::board::commands::UpdateBoardStackup command;
+    *command.mutable_board() = makeBoardDocument( aBoard );
+    *command.mutable_stackup() = aStackup;
+
+    kiapi::common::ApiRequest request;
+    request.mutable_header()->set_client_name( "kicad.qa" );
+    BOOST_REQUIRE( request.mutable_message()->PackFrom( command ) );
+
+    return request;
+}
+
+
+kiapi::common::ApiRequest makeSetEnabledLayersRequest( const BOARD& aBoard, int aCopperLayerCount )
+{
+    kiapi::board::commands::SetBoardEnabledLayers command;
+    *command.mutable_board() = makeBoardDocument( aBoard );
+    command.set_copper_layer_count( aCopperLayerCount );
+
+    for( PCB_LAYER_ID layer : aBoard.GetEnabledLayers() )
+    {
+        if( !IsCopperLayer( layer ) )
+            command.add_layers( ToProtoEnum<PCB_LAYER_ID, kiapi::board::types::BoardLayer>( layer ) );
+    }
+
+    kiapi::common::ApiRequest request;
+    request.mutable_header()->set_client_name( "kicad.qa" );
+    BOOST_REQUIRE( request.mutable_message()->PackFrom( command ) );
+
+    return request;
+}
+
+
+kiapi::board::BoardStackup getStackup( API_HANDLER_PCB& aHandler, const BOARD& aBoard )
+{
+    kiapi::common::ApiRequest request = makeGetStackupRequest( aBoard );
+    API_RESULT                result = aHandler.Handle( request );
+    BOOST_REQUIRE( result.has_value() );
+
+    kiapi::board::commands::BoardStackupResponse response;
+    BOOST_REQUIRE( result->message().UnpackTo( &response ) );
+    return response.stackup();
+}
+
+
+/// JLCPCB JLC04161H-7628 thicknesses (nm): copper and dielectric layers, top to bottom.
+const std::vector<int64_t> JLC_4L_COPPER = { 35000, 15200, 15200, 35000 };
+const std::vector<int64_t> JLC_4L_DIELECTRIC = { 210400, 1065000, 210400 };
+
+
+/// The board's stackup with the JLC04161H-7628 copper and dielectric thicknesses.
+kiapi::board::BoardStackup makeJlc4LayerStackup( kiapi::board::BoardStackup aStackup )
+{
+    using namespace kiapi::board;
+    size_t copper = 0;
+    size_t dielectric = 0;
+
+    for( BoardStackupLayer& layer : *aStackup.mutable_layers() )
+    {
+        if( layer.type() == BoardStackupLayerType::BSLT_COPPER )
+        {
+            BOOST_REQUIRE( copper < JLC_4L_COPPER.size() );
+            layer.mutable_thickness()->set_value_nm( JLC_4L_COPPER[copper++] );
+        }
+        else if( layer.type() == BoardStackupLayerType::BSLT_DIELECTRIC )
+        {
+            BOOST_REQUIRE( dielectric < JLC_4L_DIELECTRIC.size() );
+            int64_t thickness = JLC_4L_DIELECTRIC[dielectric];
+            bool    core = dielectric == 1;
+            dielectric++;
+
+            layer.mutable_thickness()->set_value_nm( thickness );
+            BoardStackupDielectricLayer* d = layer.mutable_dielectric();
+            d->set_type( core ? BoardStackupDielectricType::BSDT_CORE
+                              : BoardStackupDielectricType::BSDT_PREPREG );
+            BOOST_REQUIRE( d->layer_size() >= 1 );
+
+            while( d->layer_size() > 1 )
+                d->mutable_layer()->RemoveLast();
+
+            BoardStackupDielectricProperties* props = d->mutable_layer( 0 );
+            props->mutable_thickness()->set_value_nm( thickness );
+            props->set_material_name( core ? "FR4 core" : "7628" );
+            props->set_epsilon_r( core ? 4.6 : 4.4 );
+            props->set_loss_tangent( 0.02 );
+        }
+    }
+
+    BOOST_REQUIRE_EQUAL( copper, JLC_4L_COPPER.size() );
+    BOOST_REQUIRE_EQUAL( dielectric, JLC_4L_DIELECTRIC.size() );
+    return aStackup;
+}
+
+
+std::vector<int64_t> thicknesses( const kiapi::board::BoardStackup& aStackup,
+                                  kiapi::board::BoardStackupLayerType aType )
+{
+    std::vector<int64_t> out;
+
+    for( const kiapi::board::BoardStackupLayer& layer : aStackup.layers() )
+    {
+        if( layer.type() == aType )
+            out.push_back( layer.thickness().value_nm() );
+    }
+
+    return out;
+}
