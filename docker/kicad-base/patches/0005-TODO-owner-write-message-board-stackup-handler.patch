+BOOST_AUTO_TEST_CASE( UpdateBoardStackupCopperCountMismatchRejected )
+{
+    using namespace kiapi::board;
+    BOARD* board = loadBoard( wxS( "issue5830" ) );
+
+    API_HANDLER_PCB handler( m_context );
+    BoardStackup    before = getStackup( handler, *board );
+
+    // Drop In1.Cu, In2.Cu and two of the three dielectric layers: a 2-copper stackup
+    BoardStackup twoLayer = before;
+    twoLayer.clear_layers();
+    int dielectrics = 0;
+
+    for( const BoardStackupLayer& layer : before.layers() )
+    {
+        if( layer.type() == BSLT_COPPER && layer.layer() != types::BL_F_Cu && layer.layer() != types::BL_B_Cu )
+            continue;
+
+        if( layer.type() == BSLT_DIELECTRIC && dielectrics++ > 0 )
+            continue;
+
+        *twoLayer.add_layers() = layer;
+    }
+
+    kiapi::common::ApiRequest request = makeUpdateStackupRequest( *board, twoLayer );
+    API_RESULT                result = handler.Handle( request );
+
+    BOOST_REQUIRE( !result.has_value() );
+    BOOST_CHECK_EQUAL( result.error().status(), kiapi::common::ApiStatusCode::AS_BAD_REQUEST );
+    BOOST_CHECK( !board->GetDesignSettings().m_HasStackup );
+    BOOST_CHECK( getStackup( handler, *board ).SerializeAsString() == before.SerializeAsString() );
+}
