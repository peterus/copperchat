diff --git a/qa/tests/api/test_api_e2e_libraries.cpp b/qa/tests/api/test_api_e2e_libraries.cpp
index 869f234f..1c055fa7 100644
--- a/qa/tests/api/test_api_e2e_libraries.cpp
+++ b/qa/tests/api/test_api_e2e_libraries.cpp
@@ -321,4 +321,28 @@ BOOST_FIXTURE_TEST_CASE( DeleteFootprintFromLibrary, API_SERVER_E2E_FIXTURE )
 }
 
 
+// The headless footprint editor holds one footprint, so opening another one replaces it
+BOOST_FIXTURE_TEST_CASE( OpenFootprintReplacesOpenFootprint, API_SERVER_E2E_FIXTURE )
+{
+    BOOST_REQUIRE_MESSAGE( Start(), LastError() );
+
+    TEMP_PROJECT project;
+    PrepareLibrary( Client(), project, { FP_NAME, wxS( "Second" ) } );
+
+    types::DocumentSpecifier first;
+    types::DocumentSpecifier second;
+    BOOST_REQUIRE_MESSAGE( Client().OpenDocument( wxString( LIB_NICKNAME ) + wxS( ":" ) + FP_NAME,
+                                                  types::DOCTYPE_FOOTPRINT, &first ),
+                           Client().LastError() );
+    BOOST_REQUIRE_MESSAGE( Client().OpenDocument( wxString( LIB_NICKNAME ) + wxS( ":Second" ),
+                                                  types::DOCTYPE_FOOTPRINT, &second ),
+                           Client().LastError() );
+
+    commands::CloseDocument close;
+    *close.mutable_document() = second;
+    google::protobuf::Empty empty;
+    BOOST_CHECK_EQUAL( Send( Client(), close, &empty ), AS_OK );
+}
+
+
 BOOST_AUTO_TEST_SUITE_END()
