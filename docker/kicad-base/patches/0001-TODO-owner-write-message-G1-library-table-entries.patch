+HANDLER_RESULT<LibraryTableResponse>
+API_HANDLER_LIBRARIES::handleGetLibraryTable( const HANDLER_CONTEXT<GetLibraryTable>& aCtx )
+{
+    LIBRARY_TABLE_TYPE type = FromProtoEnum<LIBRARY_TABLE_TYPE, LibraryType>( aCtx.Request.type() );
+
+    if( type == LIBRARY_TABLE_TYPE::UNINITIALIZED )
+        return tl::unexpected( makeBadRequest( wxS( "a valid library type is required" ) ) );
+
+    LIBRARY_TABLE_SCOPE scope = FromProtoEnum<LIBRARY_TABLE_SCOPE>( aCtx.Request.scope() );
+
+    if( scope == LIBRARY_TABLE_SCOPE::UNINITIALIZED )
+        return tl::unexpected( makeBadRequest( wxS( "unknown library table scope" ) ) );
+
+    LIBRARY_MANAGER&     manager = Pgm().GetLibraryManager();
+    LibraryTableResponse response;
+
+    auto packRows =
+            [&]( const std::deque<LIBRARY_TABLE_ROW>& aRows )
+            {
+                for( const LIBRARY_TABLE_ROW& row : aRows )
+                {
+                    kiapi::common::types::LibraryTableEntry* entry = response.add_rows();
+                    packTableEntry( *entry, type, row );
+
+                    if( aCtx.Request.substituted() )
+                        entry->set_uri( LIBRARY_MANAGER::GetFullURI( &row, true ).ToUTF8() );
+                }
+            };
+
+    if( scope == LIBRARY_TABLE_SCOPE::BOTH )
+    {
+        // Project rows first: they take precedence over global rows with the same nickname
+        for( LIBRARY_TABLE_SCOPE single : { LIBRARY_TABLE_SCOPE::PROJECT, LIBRARY_TABLE_SCOPE::GLOBAL } )
+        {
+            if( std::optional<LIBRARY_TABLE*> table = manager.Table( type, single ) )
+                packRows( ( *table )->Rows() );
+        }
+
+        return response;
+    }
+
+    std::optional<LIBRARY_TABLE*> optTable = manager.Table( type, scope );
+
+    if( !optTable )
+    {
+        return tl::unexpected( makeBadRequest( scope == LIBRARY_TABLE_SCOPE::PROJECT
+                                                       ? wxS( "no project is open" )
+                                                       : wxS( "the global library table is not available" ) ) );
+    }
+
+    const LIBRARY_TABLE* table = *optTable;
+
+    kiapi::common::types::LibraryTable* tableMsg = response.mutable_table();
+    tableMsg->set_path( table->Path().ToUTF8() );
+    tableMsg->set_scope( ToProtoEnum<LIBRARY_TABLE_SCOPE, LibraryTableScope>( table->Scope() ) );
+    tableMsg->set_valid( table->IsOk() );
+
+    if( !table->IsOk() )
+        tableMsg->set_error_message( table->ErrorDescription().ToUTF8() );
+
+    packRows( table->Rows() );
+
+    return response;
+}
