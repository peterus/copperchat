+HANDLER_RESULT<LibraryCommandStatus>
+API_HANDLER_LIBRARIES::handleUpdateLibraryTableEntry( const HANDLER_CONTEXT<UpdateLibraryTableEntry>& aCtx )
+{
+    const kiapi::common::types::LibraryTableEntry& entry = aCtx.Request.entry();
+    HANDLER_RESULT<LIBRARY_TABLE*> optTable = tableForMutation( entry.type(), aCtx.Request.scope() );
+
+    if( !optTable )
+        return tl::unexpected( optTable.error() );
+
+    if( entry.uri().empty() )
+        return tl::unexpected( makeBadRequest( wxS( "a library table entry needs a URI" ) ) );
+
+    LIBRARY_TABLE*                    table = *optTable;
+    wxString                          nickname = wxString::FromUTF8( entry.nickname() );
+    std::optional<LIBRARY_TABLE_ROW*> row = table->Row( nickname );
+
+    if( !row )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_NOT_FOUND,
+                                         wxString::Format( wxS( "Library '%s' not found in %s" ), nickname,
+                                                           table->Path() ) );
+    }
+
+    if( table->IsReadOnly() )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_READ_ONLY,
+                                         wxString::Format( wxS( "Library table '%s' is read-only" ),
+                                                           table->Path() ) );
+    }
+
+    Pgm().GetLibraryManager().AbortAsyncLoads();
+
+    unpackTableEntry( entry, **row );
+
+    return saveAndReloadTable( *table, FromProtoEnum<LIBRARY_TABLE_TYPE, LibraryType>( entry.type() ) );
+}
+
+
+HANDLER_RESULT<LibraryCommandStatus>
+API_HANDLER_LIBRARIES::handleDeleteLibraryTableEntry( const HANDLER_CONTEXT<DeleteLibraryTableEntry>& aCtx )
+{
+    HANDLER_RESULT<LIBRARY_TABLE*> optTable = tableForMutation( aCtx.Request.type(), aCtx.Request.scope() );
+
+    if( !optTable )
+        return tl::unexpected( optTable.error() );
+
+    LIBRARY_TABLE* table = *optTable;
+    wxString       nickname = wxString::FromUTF8( aCtx.Request.nickname() );
+
+    if( !table->HasRow( nickname ) )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_NOT_FOUND,
+                                         wxString::Format( wxS( "Library '%s' not found in %s" ), nickname,
+                                                           table->Path() ) );
+    }
+
+    if( table->IsReadOnly() )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_READ_ONLY,
+                                         wxString::Format( wxS( "Library table '%s' is read-only" ),
+                                                           table->Path() ) );
+    }
+
+    Pgm().GetLibraryManager().AbortAsyncLoads();
+
+    std::erase_if( table->Rows(),
+                   [&]( const LIBRARY_TABLE_ROW& aRow )
+                   {
+                       return aRow.Nickname() == nickname;
+                   } );
+
+    return saveAndReloadTable( *table, FromProtoEnum<LIBRARY_TABLE_TYPE, LibraryType>( aCtx.Request.type() ) );
+}
+
+
+LIBRARY_MANAGER_ADAPTER* API_HANDLER_LIBRARIES::ensureAdapter( LIBRARY_TABLE_TYPE aType )
+{
+    LIBRARY_MANAGER& manager = Pgm().GetLibraryManager();
+
+    if( std::optional<LIBRARY_MANAGER_ADAPTER*> adapter = manager.Adapter( aType ) )
+        return *adapter;
+
+    // In headless mode the adapters of the symbol and footprint libraries are created by their
+    // kifaces, which are only loaded on demand
+    if( !m_kiway || aType == LIBRARY_TABLE_TYPE::DESIGN_BLOCK )
+        return nullptr;
+
+    KIFACE* kiface = m_kiway->KiFACE( aType == LIBRARY_TABLE_TYPE::SYMBOL ? KIWAY::FACE_SCH : KIWAY::FACE_PCB );
+
+    if( !kiface )
+        return nullptr;
+
+    if( m_handlerRegisterCallback )
+        m_handlerRegisterCallback( kiface );
+
+    return manager.Adapter( aType ).value_or( nullptr );
+}
