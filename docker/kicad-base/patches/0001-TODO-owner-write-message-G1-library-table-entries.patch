+HANDLER_RESULT<LibraryCommandStatus>
+API_HANDLER_LIBRARIES::handleAddLibraryTableEntry( const HANDLER_CONTEXT<AddLibraryTableEntry>& aCtx )
+{
+    const kiapi::common::types::LibraryTableEntry& entry = aCtx.Request.entry();
+    HANDLER_RESULT<LIBRARY_TABLE*> optTable = tableForMutation( entry.type(), aCtx.Request.scope() );
+
+    if( !optTable )
+        return tl::unexpected( optTable.error() );
+
+    wxString nickname = wxString::FromUTF8( entry.nickname() );
+
+    if( nickname.IsEmpty() || entry.uri().empty() )
+        return tl::unexpected( makeBadRequest( wxS( "a library table entry needs a nickname and a URI" ) ) );
+
+    if( unsigned illegal = LIB_ID::FindIllegalLibraryNameChar( entry.nickname() ) )
+    {
+        return tl::unexpected( makeBadRequest( wxString::Format( wxS( "illegal character '%c' in nickname '%s'" ),
+                                                                 illegal, nickname ) ) );
+    }
+
+    LIBRARY_TABLE*     table = *optTable;
+    LIBRARY_TABLE_TYPE type = FromProtoEnum<LIBRARY_TABLE_TYPE, LibraryType>( entry.type() );
+
+    if( table->HasRow( nickname ) )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_ALREADY_EXISTS,
+                                         wxString::Format( wxS( "Library '%s' already exists in %s" ), nickname,
+                                                           table->Path() ) );
+    }
+
+    if( table->IsReadOnly() )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_READ_ONLY,
+                                         wxString::Format( wxS( "Library table '%s' is read-only" ),
+                                                           table->Path() ) );
+    }
+
+    LIBRARY_MANAGER& manager = Pgm().GetLibraryManager();
+    LIBRARY_TABLE_SCOPE scope = table->Scope();
+
+    // Background loads hold raw row pointers into the table being modified
+    manager.AbortAsyncLoads();
+
+    LIBRARY_TABLE_ROW& row = table->InsertRow();
+    row.SetNickname( nickname );
+
+    // KiCad's own format is the only one the API can create or write libraries in
+    row.SetType( wxS( "KiCad" ) );
+    unpackTableEntry( entry, row );
+
+    LibraryCommandStatus status = saveAndReloadTable( *table, type );
+
+    if( status.code() != LibraryCommandStatus::LCS_OK || !aCtx.Request.create_library() )
+        return status;
+
+    wxString path = LIBRARY_MANAGER::ExpandURI( wxString::FromUTF8( entry.uri() ),
+                                                Pgm().GetSettingsManager().Prj() );
+
+    if( wxFileName::Exists( path ) )
+        return status;
+
+    LIBRARY_MANAGER_ADAPTER* adapter = ensureAdapter( type );
+    wxString                 error;
+
+    if( !adapter )
+        error = wxS( "no library adapter is available for this library type" );
+    else if( !adapter->CreateLibrary( nickname ) )
+        error = wxString::Format( wxS( "could not create a library at '%s'" ), path );
+
+    if( !error.IsEmpty() )
+    {
+        // Don't leave a row behind that points at nothing
+        if( std::optional<LIBRARY_TABLE*> reloaded = manager.Table( type, scope ) )
+        {
+            std::erase_if( ( *reloaded )->Rows(),
+                           [&]( const LIBRARY_TABLE_ROW& aRow )
+                           {
+                               return aRow.Nickname() == nickname;
+                           } );
+
+            saveAndReloadTable( **reloaded, type );
+        }
+
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_ERROR, error );
+    }
+
+    adapter->ReloadLibraryEntry( nickname, scope );
+    return status;
+}
+
