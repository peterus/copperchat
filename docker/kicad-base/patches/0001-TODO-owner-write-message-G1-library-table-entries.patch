+    BOOST_REQUIRE_MESSAGE( Client().OpenDocument( project.Board() ), Client().LastError() );
+
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), MakeAddRequest() ), LibraryCommandStatus::LCS_OK );
+    BOOST_CHECK( project.File( wxS( "api_e2e_fp.pretty" ) ).DirExists() );
+    BOOST_CHECK( ReadFile( project.File( wxS( "fp-lib-table" ) ) ).Contains( wxS( "api_e2e_fp.pretty" ) ) );
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), MakeAddRequest() ), LibraryCommandStatus::LCS_ALREADY_EXISTS );
+
+    commands::LibraryTableResponse table = GetProjectFootprintTable( Client() );
+    BOOST_CHECK( table.table().valid() );
+    BOOST_REQUIRE_EQUAL( table.rows_size(), 1 );
+    BOOST_CHECK_EQUAL( table.rows( 0 ).nickname(), LIB_NICKNAME );
+    BOOST_CHECK_EQUAL( table.rows( 0 ).uri(), LIB_URI );
+    BOOST_CHECK_EQUAL( table.rows( 0 ).description(), "API test library" );
+
+    commands::UpdateLibraryTableEntry update;
+    *update.mutable_entry() = table.rows( 0 );
+    update.mutable_entry()->set_description( "updated" );
+    update.mutable_entry()->set_disabled( true );
+    update.set_scope( types::LTS_PROJECT );
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), update ), LibraryCommandStatus::LCS_OK );
+
+    table = GetProjectFootprintTable( Client() );
+    BOOST_REQUIRE_EQUAL( table.rows_size(), 1 );
+    BOOST_CHECK_EQUAL( table.rows( 0 ).description(), "updated" );
+    BOOST_CHECK( table.rows( 0 ).disabled() );
+
+    commands::DeleteLibraryTableEntry remove;
+    remove.set_type( types::LT_FOOTPRINT );
+    remove.set_nickname( LIB_NICKNAME );
+    remove.set_scope( types::LTS_PROJECT );
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), remove ), LibraryCommandStatus::LCS_OK );
+    BOOST_CHECK_EQUAL( GetProjectFootprintTable( Client() ).rows_size(), 0 );
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), remove ), LibraryCommandStatus::LCS_NOT_FOUND );
+
+    commands::AddLibraryTableEntry both = MakeAddRequest();
+    both.set_scope( types::LTS_BOTH );
+    LibraryCommandStatus status;
+    BOOST_CHECK_EQUAL( Send( Client(), both, &status ), AS_BAD_REQUEST );
+}
