+/// A copy of the kitchen sink board in a temporary project directory
+class TEMP_PROJECT
+{
+public:
+    TEMP_PROJECT() :
+            m_dir( "kicad_api_e2e_libraries" )
+    {
+        wxString testDataDir = wxString::FromUTF8( KI_TEST::GetPcbnewTestDataDir() );
+
+        for( const wxString& ext : { wxString( wxS( "kicad_pcb" ) ), wxString( wxS( "kicad_pro" ) ) } )
+        {
+            wxFileName src( testDataDir, wxS( "api_kitchen_sink." ) + ext );
+            wxFileName dst( m_dir.PathStr(), src.GetFullName() );
+            BOOST_REQUIRE( wxCopyFile( src.GetFullPath(), dst.GetFullPath(), true ) );
+        }
+    }
+
+    wxString Board() const
+    {
+        return wxFileName( m_dir.PathStr(), wxS( "api_kitchen_sink.kicad_pcb" ) ).GetFullPath();
+    }
+
+    wxFileName File( const wxString& aRelPath ) const
+    {
+        return wxFileName( m_dir.PathStr() + wxFileName::GetPathSeparator() + aRelPath );
+    }
+
+private:
+    KI_TEST::SCOPED_TEMP_DIR m_dir;
+};
