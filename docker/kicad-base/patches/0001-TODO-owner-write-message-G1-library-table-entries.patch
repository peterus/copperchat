+template <typename RESPONSE>
+ApiStatusCode Send( API_TEST_CLIENT& aClient, const google::protobuf::Message& aRequest, RESPONSE* aResponse )
+{
+    ApiResponse response;
+
+    BOOST_REQUIRE_MESSAGE( aClient.SendCommand( aRequest, &response ), "send failed: " + aClient.LastError() );
+
+    if( response.status().status() == AS_OK )
+        BOOST_REQUIRE( response.message().UnpackTo( aResponse ) );
+
+    return response.status().status();
+}
+
+
+LibraryCommandStatus::Code SendLibraryCommand( API_TEST_CLIENT& aClient, const google::protobuf::Message& aRequest )
+{
+    LibraryCommandStatus status;
+    BOOST_REQUIRE_EQUAL( Send( aClient, aRequest, &status ), AS_OK );
+    return status.code();
+}
