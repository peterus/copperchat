+/**
+ * Resolves the single library table a table-mutation command addresses.
+ *
+ * @return the table, or a bad-request status if the type or scope is invalid or the table
+ *         does not exist (e.g. a project table when no project is open)
+ */
+static HANDLER_RESULT<LIBRARY_TABLE*> tableForMutation( LibraryType aType, LibraryTableScope aScope )
+{
+    LIBRARY_TABLE_TYPE type = FromProtoEnum<LIBRARY_TABLE_TYPE, LibraryType>( aType );
+
+    if( type == LIBRARY_TABLE_TYPE::UNINITIALIZED )
+        return tl::unexpected( makeBadRequest( wxS( "a valid library type is required" ) ) );
+
+    if( aScope != LibraryTableScope::LTS_GLOBAL && aScope != LibraryTableScope::LTS_PROJECT )
+        return tl::unexpected( makeBadRequest( wxS( "choose one table: LTS_GLOBAL or LTS_PROJECT" ) ) );
+
+    LIBRARY_TABLE_SCOPE scope = FromProtoEnum<LIBRARY_TABLE_SCOPE>( aScope );
+
+    std::optional<LIBRARY_TABLE*> table = Pgm().GetLibraryManager().Table( type, scope );
+
+    if( !table )
+    {
+        return tl::unexpected( makeBadRequest( scope == LIBRARY_TABLE_SCOPE::PROJECT
+                                                       ? wxS( "no project is open" )
+                                                       : wxS( "the global library table is not available" ) ) );
+    }
+
+    return *table;
+}
+
+
+/**
+ * Writes a modified library table to disk and reloads it, so that the library manager and its
+ * adapters see the change.  On a save error the table is reloaded from disk too, which drops the
+ * in-memory modification.
+ */
+static LibraryCommandStatus saveAndReloadTable( LIBRARY_TABLE& aTable, LIBRARY_TABLE_TYPE aType )
+{
+    LIBRARY_TABLE_SCOPE  scope = aTable.Scope();
+    LIBRARY_RESULT<void> result = aTable.Save();
+
+    // aTable is replaced by the reload and must not be used after this point
+    Pgm().GetLibraryManager().ReloadTables( scope, { aType } );
+
+    if( !result )
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_ERROR, result.error().message );
+
+    return makeLibraryCommandStatus( LibraryCommandStatus::LCS_OK );
+}
+
+
+static void unpackTableEntry( const kiapi::common::types::LibraryTableEntry& aEntry, LIBRARY_TABLE_ROW& aRow )
+{
+    aRow.SetURI( wxString::FromUTF8( aEntry.uri() ) );
+    aRow.SetDescription( wxString::FromUTF8( aEntry.description() ) );
+
+    std::map<std::string, UTF8> options;
+
+    for( const auto& [key, value] : aEntry.options() )
+        options[key] = UTF8( value );
+
+    aRow.SetOptions( LIBRARY_TABLE::FormatOptions( &options ) );
+    aRow.SetDisabled( aEntry.disabled() );
+    aRow.SetHidden( aEntry.hidden() );
+}
