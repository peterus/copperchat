+BOOST_FIXTURE_TEST_CASE( DeleteFootprintFromLibrary, API_SERVER_E2E_FIXTURE )
+{
+    BOOST_REQUIRE_MESSAGE( Start(), LastError() );
+
+    TEMP_PROJECT project;
+    PrepareLibrary( Client(), project, { FP_NAME, wxS( "Second" ) } );
+
+    // A table change drops the loaded libraries, so the delete has to load the library itself
+    commands::UpdateLibraryTableEntry update;
+    *update.mutable_entry() = GetProjectFootprintTable( Client() ).rows( 0 );
+    update.mutable_entry()->set_description( "reloaded" );
+    update.set_scope( types::LTS_PROJECT );
+    BOOST_REQUIRE_EQUAL( SendLibraryCommand( Client(), update ), LibraryCommandStatus::LCS_OK );
+
+    commands::DeleteLibraryItem remove;
+    remove.set_type( types::LT_FOOTPRINT );
+    remove.mutable_item()->set_library_nickname( LIB_NICKNAME );
+    remove.mutable_item()->set_entry_name( FP_NAME );
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), remove ), LibraryCommandStatus::LCS_OK );
+    BOOST_CHECK( !project.File( wxS( "api_e2e_fp.pretty/" ) + wxString( FP_NAME ) + wxS( ".kicad_mod" ) ).FileExists() );
+    BOOST_CHECK_EQUAL( SendLibraryCommand( Client(), remove ), LibraryCommandStatus::LCS_NOT_FOUND );
+
+    commands::GetLibraryItems items;
+    items.set_type( types::LT_FOOTPRINT );
+    items.add_nickname( LIB_NICKNAME );
+    commands::LibraryItemsResponse remaining;
+    BOOST_REQUIRE_EQUAL( Send( Client(), items, &remaining ), AS_OK );
+    BOOST_REQUIRE_EQUAL( remaining.items_size(), 1 );
+    BOOST_CHECK_EQUAL( remaining.items( 0 ).entry_name(), "Second" );
+}
+
