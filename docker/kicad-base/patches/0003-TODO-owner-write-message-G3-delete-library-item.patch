+HANDLER_RESULT<LibraryCommandStatus>
+API_HANDLER_LIBRARIES::handleDeleteLibraryItem( const HANDLER_CONTEXT<DeleteLibraryItem>& aCtx )
+{
+    if( aCtx.Request.type() != ToProtoEnum<LIBRARY_TABLE_TYPE, LibraryType>( m_type ) )
+    {
+        ApiResponseStatus e;
+        e.set_status( ApiStatusCode::AS_UNHANDLED );
+        return tl::unexpected( e );
+    }
+
+    wxString nickname = wxString::FromUTF8( aCtx.Request.item().library_nickname() );
+    wxString itemName = wxString::FromUTF8( aCtx.Request.item().entry_name() );
+
+    if( nickname.IsEmpty() || itemName.IsEmpty() )
+        return tl::unexpected( makeBadRequest( wxS( "both a library nickname and an item name are required" ) ) );
+
+    LIBRARY_MANAGER_ADAPTER* adapter = adapterForProject( Pgm().GetSettingsManager().Prj() );
+
+    if( !adapter )
+        return tl::unexpected( makeBadRequest( wxS( "no library adapter is available for this library type" ) ) );
+
+    std::optional<LIBRARY_TABLE_ROW*> row = adapter->GetRow( nickname );
+
+    if( !row || ( *row )->Disabled() )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_NOT_FOUND,
+                                         wxString::Format( wxS( "Library '%s' not found" ), nickname ) );
+    }
+
+    std::optional<LIB_STATUS> libStatus = adapter->LoadLibraryEntry( nickname );
+
+    if( !libStatus || libStatus->load_status != LOAD_STATUS::LOADED )
+    {
+        wxString msg = wxString::Format( wxS( "Library '%s' could not be loaded" ), nickname );
+
+        if( libStatus && libStatus->error )
+            msg << wxS( ": " ) << libStatus->error->message;
+
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_ERROR, msg );
+    }
+
+    if( !adapter->IsWritable( nickname ) )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_READ_ONLY,
+                                         wxString::Format( wxS( "Library '%s' is read-only" ), nickname ) );
+    }
+
+    std::vector<wxString> names = getItemNames( *adapter, nickname );
+
+    if( std::ranges::find( names, itemName ) == names.end() )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_NOT_FOUND,
+                                         wxString::Format( wxS( "'%s' not found in library '%s'" ),
+                                                           itemName, nickname ) );
+    }
+
+    try
+    {
+        deleteLibraryItem( *adapter, nickname, itemName );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        return makeLibraryCommandStatus( LibraryCommandStatus::LCS_ERROR, ioe.What() );
+    }
+
+    return makeLibraryCommandStatus( LibraryCommandStatus::LCS_OK );
+}
