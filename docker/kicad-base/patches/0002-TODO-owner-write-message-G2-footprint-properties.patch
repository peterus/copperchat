+/// The footprint open in the headless footprint editor, read back by its own ID
+kiapi::board::types::FootprintInstance GetEditedFootprint( API_TEST_CLIENT&                aClient,
+                                                           const types::DocumentSpecifier& aDocument )
+{
+    commands::GetItems itemsRequest;
+    *itemsRequest.mutable_header()->mutable_document() = aDocument;
+    itemsRequest.add_types( types::KOT_PCB_PAD );
+
+    commands::GetItemsResponse items;
+    BOOST_REQUIRE_EQUAL( Send( aClient, itemsRequest, &items ), AS_OK );
+    BOOST_REQUIRE_GT( items.items_size(), 0 );
+
+    kiapi::board::types::Pad pad;
+    BOOST_REQUIRE( items.items( 0 ).UnpackTo( &pad ) );
+
+    commands::GetItemsById byIdRequest;
+    *byIdRequest.mutable_header()->mutable_document() = aDocument;
+    *byIdRequest.add_items() = pad.parent();
+
+    commands::GetItemsResponse byId;
+    BOOST_REQUIRE_EQUAL( Send( aClient, byIdRequest, &byId ), AS_OK );
+    BOOST_REQUIRE_EQUAL( byId.items_size(), 1 );
+
+    kiapi::board::types::FootprintInstance footprint;
+    BOOST_REQUIRE( byId.items( 0 ).UnpackTo( &footprint ) );
+    return footprint;
+}
