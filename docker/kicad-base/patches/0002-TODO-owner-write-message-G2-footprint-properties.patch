+/// Adds the test library to the project table and copies a footprint into it under each name
+void PrepareLibrary( API_TEST_CLIENT& aClient, const TEMP_PROJECT& aProject, const std::vector<wxString>& aNames )
+{
+    BOOST_REQUIRE_MESSAGE( aClient.OpenDocument( aProject.Board() ), aClient.LastError() );
+    BOOST_REQUIRE_EQUAL( SendLibraryCommand( aClient, MakeAddRequest() ), LibraryCommandStatus::LCS_OK );
+
+    wxFileName source( wxString::FromUTF8( KI_TEST::GetTestDataRootDir() ) + wxS( "/libraries/Resistor_SMD.pretty" ),
+                       wxString( FP_NAME ) + wxS( ".kicad_mod" ) );
+
+    for( const wxString& name : aNames )
+    {
+        wxFileName copy = aProject.File( wxS( "api_e2e_fp.pretty/" ) + name + wxS( ".kicad_mod" ) );
+        BOOST_REQUIRE( wxCopyFile( source.GetFullPath(), copy.GetFullPath() ) );
+    }
+
+    commands::ReloadLibrary reload;
+    reload.set_type( types::LT_FOOTPRINT );
+    reload.set_scope( types::LTS_PROJECT );
+    reload.add_nickname( LIB_NICKNAME );
+    BOOST_REQUIRE_EQUAL( SendLibraryCommand( aClient, reload ), LibraryCommandStatus::LCS_OK );
+}
+
 
