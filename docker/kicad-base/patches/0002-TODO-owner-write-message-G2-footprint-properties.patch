+BOOST_FIXTURE_TEST_CASE( UpdateFootprintProperties, API_SERVER_E2E_FIXTURE )
+{
+    BOOST_REQUIRE_MESSAGE( Start(), LastError() );
+
+    TEMP_PROJECT project;
+    PrepareLibrary( Client(), project, { FP_NAME } );
+
+    types::DocumentSpecifier document;
+    wxString                 libId = wxString( LIB_NICKNAME ) + wxS( ":" ) + FP_NAME;
+    BOOST_REQUIRE_MESSAGE( Client().OpenDocument( libId, types::DOCTYPE_FOOTPRINT, &document ), Client().LastError() );
+
+    kiapi::board::types::FootprintInstance footprint = GetEditedFootprint( Client(), document );
+    footprint.mutable_definition()->mutable_attributes()->set_description( "API description" );
+    footprint.mutable_definition()->mutable_attributes()->set_keywords( "api keywords" );
+    footprint.mutable_attributes()->set_mounting_style( kiapi::board::types::FMS_THROUGH_HOLE );
+    footprint.mutable_attributes()->set_exclude_from_bill_of_materials( true );
+    footprint.mutable_overrides()->mutable_copper_clearance()->set_value_nm( 200000 );
+
+    commands::UpdateItems update;
+    *update.mutable_header()->mutable_document() = document;
+    update.add_items()->PackFrom( footprint );
+
+    commands::UpdateItemsResponse updated;
+    BOOST_REQUIRE_EQUAL( Send( Client(), update, &updated ), AS_OK );
+    BOOST_REQUIRE_EQUAL( updated.updated_items_size(), 1 );
+    BOOST_CHECK_MESSAGE( updated.updated_items( 0 ).status().code() == commands::ISC_OK,
+                         updated.updated_items( 0 ).status().error_message() );
+
+    kiapi::board::types::FootprintInstance after = GetEditedFootprint( Client(), document );
+    BOOST_CHECK_EQUAL( after.definition().attributes().description(), "API description" );
+    BOOST_CHECK_EQUAL( after.definition().attributes().keywords(), "api keywords" );
+    BOOST_CHECK_EQUAL( after.attributes().mounting_style(), kiapi::board::types::FMS_THROUGH_HOLE );
+    BOOST_CHECK( after.attributes().exclude_from_bill_of_materials() );
+    BOOST_CHECK_EQUAL( after.overrides().copper_clearance().value_nm(), 200000 );
+    BOOST_CHECK_EQUAL( after.definition().items_size(), footprint.definition().items_size() );
+
+    commands::SaveDocument save;
+    *save.mutable_document() = document;
+    google::protobuf::Empty empty;
+    BOOST_REQUIRE_EQUAL( Send( Client(), save, &empty ), AS_OK );
+
+    wxString saved = ReadFile( project.File( wxS( "api_e2e_fp.pretty/" ) + wxString( FP_NAME ) + wxS( ".kicad_mod" ) ) );
+    BOOST_CHECK( saved.Contains( wxS( "(descr \"API description\")" ) ) );
+    BOOST_CHECK( saved.Contains( wxS( "(tags \"api keywords\")" ) ) );
+    BOOST_CHECK( saved.Contains( wxS( "(attr through_hole exclude_from_bom)" ) ) );
+}
