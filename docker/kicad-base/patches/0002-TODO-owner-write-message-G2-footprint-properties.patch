+/**
+ * Copies the properties a footprint has of its own (those of a library footprint, not of its
+ * placement or its children) from @a aSource to @a aTarget.
+ *
+ * Not copied: embedded files, custom properties, and the instance data of a board footprint
+ * (position, orientation, layer, locked state, symbol link, fields).
+ */
+static void CopyFootprintDefinitionProperties( const FOOTPRINT& aSource, FOOTPRINT& aTarget )
+{
+    aTarget.SetLibDescription( aSource.GetLibDescription() );
+    aTarget.SetKeywords( aSource.GetKeywords() );
+    aTarget.SetAttributes( aSource.GetAttributes() );
+    aTarget.SetAllowMissingCourtyard( aSource.AllowMissingCourtyard() );
+    aTarget.SetAllowSolderMaskBridges( aSource.AllowSolderMaskBridges() );
+
+    aTarget.SetLocalClearance( aSource.GetLocalClearance() );
+    aTarget.SetLocalSolderMaskMargin( aSource.GetLocalSolderMaskMargin() );
+    aTarget.SetLocalSolderPasteMargin( aSource.GetLocalSolderPasteMargin() );
+    aTarget.SetLocalSolderPasteMarginRatio( aSource.GetLocalSolderPasteMarginRatio() );
+    aTarget.SetLocalZoneConnection( aSource.GetLocalZoneConnection() );
+
+    aTarget.ClearNetTiePadGroups();
+
+    for( const wxString& group : aSource.GetNetTiePadGroups() )
+        aTarget.AddNetTiePadGroup( group );
+
+    aTarget.SetPrivateLayers( aSource.GetPrivateLayers() );
+    aTarget.SetDuplicatePadNumbersAreJumpers( aSource.GetDuplicatePadNumbersAreJumpers() );
+    aTarget.JumperPadGroups() = aSource.JumperPadGroups();
+    aTarget.SetHeight( aSource.GetHeight() );
+    aTarget.Models() = aSource.Models();
+}
+
