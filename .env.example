# CopperChat configuration — copy to .env and fill in.

# --- Model credentials (one of the two is required) -------------------------------------
# Create a token with your own Claude subscription:   claude setup-token
# CopperChat offers no login flow of its own; Anthropic's terms apply to your credentials.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- App login (always on) ----------------------------------------------------------------
# The password seeds the stored argon2 hash on the first start (changing it later has no
# effect unless /data/copperchat.db is reset).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Network --------------------------------------------------------------------------------
# Host port of the web UI (container port 8080).
# COPPERCHAT_PORT=8080
# Host address the port is published on (default: all addresses); 127.0.0.1 = this machine
# only (recommended with the tunnel profile: Docker's published ports bypass host firewalls
# like ufw). IPv6 addresses need brackets, e.g. [::1].
# COPPERCHAT_BIND=127.0.0.1
# Public HTTPS URL, e.g. behind Cloudflare Tunnel (WebSocket Origin check).
# PUBLIC_BASE_URL=https://copperchat.example.com
# Contact for the push services (VAPID "sub" claim).
# VAPID_SUBJECT=mailto:you@example.com
# The session cookie is Secure by default (HTTPS only). Plain http on a LAN IP, e.g.
# http://192.168.1.10:8090: browsers drop Secure cookies, so login would not stick (the login
# page then says so and the server log warns). Set false only for such plain-http LAN access;
# not needed for http://localhost or behind HTTPS (docs/deployment/cloudflare.md).
# COOKIE_SECURE=false

# --- Optional: Cloudflare Tunnel (docker compose --profile tunnel up -d) ------------------
# CLOUDFLARE_TUNNEL_TOKEN=
# Proxy addresses whose X-Forwarded-For is trusted (default: the cloudflared container).
# FORWARDED_ALLOW_IPS=
# Compose network; change both if 172.30.231.0/24 clashes with a network on your host.
# COPPERCHAT_SUBNET=172.30.231.0/24
# CLOUDFLARED_IP=172.30.231.10

# --- Image ------------------------------------------------------------------------------------
# Tag of ghcr.io/peterus/copperchat: latest, a minor line (0.1) or an exact version (0.2.0).
# COPPERCHAT_VERSION=latest

# --- Development only -------------------------------------------------------------------------
# Run without a model token using the scripted fake agent.
# DEV_FAKE_AGENT=true
