+
+/** KiCad 11 footprint placement: (transform (translate x y) (rotate r) (scale sx sy)). */
+export class FootprintTransform {
+    translate?: { x: number; y: number };
+    rotate?: number;
+
+    constructor(expr: Parseable) {
+        Object.assign(
+            this,
+            parse_expr(
+                expr,
+                P.start("transform"),
+                P.object(
+                    "translate",
+                    {},
+                    P.positional("x", T.number),
+                    P.positional("y", T.number),
+                ),
+                P.pair("rotate", T.number),
+            ),
+        );
+    }
+
+    to_at(): At {
+        const at = new At();
+        at.position.set(this.translate?.x ?? 0, this.translate?.y ?? 0);
+        at.rotation = this.rotate ?? 0;
+        return at;
+    }
+}
